        <name>Auto-populate Manager onLoad</name>
        <order/>
        <script><![CDATA[function onLoad() {
    if (g_form.isNewRecord()) {
        // Auto-set manager from current user's manager
        var userId = g_user.userID;

        // Use GlideAjax or direct reference to get current user's manager
        var ga = new GlideAjax('global.UserAjax');
        ga.addParam('sysparm_name', 'getManagerID');
        ga.addParam('sysparm_user_id', userId);
        ga.getXMLAnswer(function(answer) {
            if (answer) {
                g_form.setValue('manager', answer);
            }
        });
    }
}
]]></script>
