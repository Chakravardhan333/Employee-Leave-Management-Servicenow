    <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Auto-populate manager field from employee's manager
    var employeeId = current.getValue('employee');

    if (employeeId) {
        var userGr = new GlideRecord('sys_user');
        if (userGr.get(employeeId)) {
            var managerId = userGr.getValue('manager');
            if (managerId) {
                current.setValue('manager', managerId);
            }
        }
    }
})(current, previous);
]]></script>
    <sys_name>Set Default Manager</sys_name>
    <sys_policy/>
    <template/>
    <when>before</when>
