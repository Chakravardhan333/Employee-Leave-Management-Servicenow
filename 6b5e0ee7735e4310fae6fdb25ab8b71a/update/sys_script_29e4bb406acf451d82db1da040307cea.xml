        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // If status changes to 'approved', check if current user is the employee
    var newStatus = current.getValue('status');
    var oldStatus = previous.getValue('status');

    if (newStatus == 'approved' && oldStatus != 'approved') {
        var employeeId = current.getValue('employee');
        var currentUserId = gs.getUserID();

        if (employeeId == currentUserId) {
            gs.addErrorMessage('You cannot approve your own leave request');
            current.setAbortAction(true);
        }
    }
})(current, previous);
]]></script>
